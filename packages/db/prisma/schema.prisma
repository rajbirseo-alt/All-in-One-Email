// SEO Discovery Unified Email CRM — canonical database schema.
// Conventions:
//   * Internal IDs are UUIDv7-style strings generated by the app (time-ordered, index friendly).
//   * Provider identifiers are stored alongside normalised records (providerXxxId columns).
//   * Every table that holds email content carries emailAccountId so access policies and
//     Postgres Row-Level Security can filter on it cheaply.
//   * Secrets never live in plain columns: see EmailCredential (envelope-encrypted blobs).
//   * Raw-SQL migrations add what Prisma cannot express: tsvector search columns + GIN indexes,
//     RLS policies, and REVOKE UPDATE/DELETE on audit_logs.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
  url        = env("DATABASE_URL")
}

// ───────────────────────────── Identity & access ─────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// Breadth of data a permission applies to. Ordered narrowest → widest.
enum PermissionScope {
  OWN // records the user created / owns
  ASSIGNED // conversations assigned or explicitly shared to the user
  TEAM // records belonging to teams the user leads or is a member of
  DEPARTMENT // records belonging to the user's department(s)
  ALL // company-wide
}

enum OverrideEffect {
  GRANT
  DENY
}

model User {
  id               String     @id
  email            String     @unique // lower-cased login email
  name             String
  avatarUrl        String?
  status           UserStatus @default(INVITED)
  roleId           String
  departmentId     String?
  managerId        String?
  timezone         String     @default("UTC")
  passwordHash     String? // argon2id; null when SSO-only
  mfaSecretEnc     Bytes? // envelope-encrypted TOTP secret
  mfaEnabledAt     DateTime?
  mfaLastUsedStep  Int? // last accepted TOTP time-step; blocks code replay
  isAbsent         Boolean    @default(false) // drives absence reassignment
  absentUntil      DateTime?
  lastLoginAt      DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  actionTokens UserActionToken[]
  role         Role              @relation(fields: [roleId], references: [id])
  department   Department?       @relation("DepartmentMembers", fields: [departmentId], references: [id])
  manager      User?             @relation("ManagerReports", fields: [managerId], references: [id])
  reports      User[]            @relation("ManagerReports")

  identities          UserIdentity[]
  sessions            Session[]
  permissionOverrides UserPermissionOverride[]
  teamMemberships     TeamMember[]
  ledTeams            Team[]                   @relation("TeamLeader")
  managedDepartments  Department[]             @relation("DepartmentManager")
  mailboxAccess       EmailAccountAccess[]
  assignedThreads     EmailThread[]            @relation("ThreadAssignee")
  assignmentsReceived Assignment[]             @relation("AssignmentAssignee")
  assignmentsMade     Assignment[]             @relation("AssignmentAssigner")
  statusChanges       StatusHistory[]
  notes               InternalNote[]
  mentions            NoteMention[]
  sharesReceived      ThreadShare[]            @relation("ShareTarget")
  sharesMade          ThreadShare[]            @relation("ShareAuthor")
  drafts              Draft[]
  signatures          Signature[]
  templates           Template[]
  ownedContacts       Contact[]
  ownedLeads          Lead[]
  tasksAssigned       Task[]                   @relation("TaskAssignee")
  tasksCreated        Task[]                   @relation("TaskCreator")
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  pushSubscriptions   PushSubscription[]
  auditLogs           AuditLog[]
  aiSuggestions       AiSuggestion[]
  sentMessages        EmailMessage[]           @relation("MessageSentBy")
  connectedAccounts   EmailAccount[]           @relation("AccountConnectedBy")

  @@index([roleId])
  @@index([departmentId])
  @@index([managerId])
  @@map("users")
}

/// One-time links an admin hands to an employee (set / reset password). Only the hash is stored.
model UserActionToken {
  id          String    @id
  userId      String
  purpose     String // "set_password"
  tokenHash   String    @unique
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_action_tokens")
}

/// Employee login via company SSO (Google Workspace / Microsoft Entra ID).
/// Separate from mailbox connections: logging in never grants mailbox access.
model UserIdentity {
  id              String   @id
  userId          String
  provider        String // "google" | "microsoft"
  providerSubject String // OIDC `sub` / `oid`
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("user_identities")
}

model Session {
  id         String    @id
  userId     String
  tokenHash  String    @unique // SHA-256 of the opaque cookie token; raw token never stored
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  authMethod String // "google" | "microsoft" | "password+totp" | "password"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String   @id
  key         String   @unique // SUPER_ADMIN, MD, DEPT_MANAGER, TEAM_LEADER, EMPLOYEE, SALES, HR, FINANCE
  name        String
  description String?
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id
  key         String  @unique // e.g. "conversation.read", "conversation.reply", "account.manage"
  description String?

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  scope        PermissionScope

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Per-user exceptions on top of the role (e.g. grant one employee department-wide read).
model UserPermissionOverride {
  userId       String
  permissionId String
  effect       OverrideEffect
  scope        PermissionScope?
  reason       String?
  grantedById  String?
  createdAt    DateTime         @default(now())
  expiresAt    DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permission_overrides")
}

model Department {
  id         String   @id
  name       String
  slug       String   @unique
  managerId  String?
  calendarId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  manager         User?                @relation("DepartmentManager", fields: [managerId], references: [id])
  calendar        BusinessCalendar?    @relation(fields: [calendarId], references: [id])
  members         User[]               @relation("DepartmentMembers")
  teams           Team[]
  emailAccounts   EmailAccount[]
  mailboxAccess   EmailAccountAccess[]
  threads         EmailThread[]
  assignments     Assignment[]
  contacts        Contact[]
  slaPolicies     SlaPolicy[]
  templates       Template[]
  assignmentRules AssignmentRule[]

  @@map("departments")
}

model Team {
  id           String   @id
  name         String
  departmentId String
  leaderId     String?
  createdAt    DateTime @default(now())

  department      Department           @relation(fields: [departmentId], references: [id])
  leader          User?                @relation("TeamLeader", fields: [leaderId], references: [id])
  members         TeamMember[]
  mailboxAccess   EmailAccountAccess[]
  threads         EmailThread[]
  assignments     Assignment[]
  assignmentRules AssignmentRule[]
  roundRobin      RoundRobinCursor?

  @@unique([departmentId, name])
  @@map("teams")
}

model TeamMember {
  teamId     String
  userId     String
  // Excluded members are skipped by round-robin (e.g. on leave) without losing membership.
  inRotation Boolean  @default(true)
  joinedAt   DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// ───────────────────────────── Mailboxes ─────────────────────────────

enum MailProvider {
  GMAIL // Gmail + Google Workspace, via Gmail API
  MICROSOFT // Outlook.com + Microsoft 365, via Microsoft Graph
  IMAP // any IMAP/SMTP provider incl. custom domains
}

enum AccountStatus {
  CONNECTING
  INITIAL_SYNC
  ACTIVE
  NEEDS_REAUTH // refresh token revoked/expired; user must reconnect
  ERROR // repeated sync failures; see lastError
  PAUSED
  DISCONNECTED
}

model EmailAccount {
  id                  String        @id
  provider            MailProvider
  emailAddress        String        @unique
  displayName         String?
  departmentId        String?
  status              AccountStatus @default(CONNECTING)
  connectedById       String
  syncFromDate        DateTime? // initial sync window start
  // Provider sync cursors
  gmailHistoryId      String?
  // Health
  lastSyncedAt        DateTime?
  lastSuccessAt       DateTime?
  lastError           String?
  lastErrorAt         DateTime?
  consecutiveFailures Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  disconnectedAt      DateTime?
  // Data-retention: content purge scheduled after disconnect (see docs/06)
  purgeAfter          DateTime?
  purgedAt            DateTime? // set by the retention job once mail content was deleted

  department    Department?                @relation(fields: [departmentId], references: [id])
  connectedBy   User                       @relation("AccountConnectedBy", fields: [connectedById], references: [id])
  credential    EmailCredential?
  access        EmailAccountAccess[]
  folders       EmailFolder[]
  threads       EmailThread[]
  messages      EmailMessage[]
  subscriptions EmailWebhookSubscription[]
  syncLogs      SyncLog[]
  drafts        Draft[]
  signatures    Signature[]

  @@index([status])
  @@index([departmentId])
  @@map("email_accounts")
}

enum CredentialKind {
  OAUTH
  PASSWORD
}

enum TransportSecurity {
  TLS // implicit TLS (993 / 465)
  STARTTLS
}

/// Envelope encryption: payload (JSON of tokens or password) is AES-256-GCM encrypted with a
/// random data key; the data key is wrapped by the KMS key identified by keyId/keyVersion.
model EmailCredential {
  id                   String             @id
  emailAccountId       String             @unique
  kind                 CredentialKind
  ciphertext           Bytes
  iv                   Bytes
  authTag              Bytes
  wrappedDataKey       Bytes
  keyId                String
  keyVersion           Int
  scopes               String[]
  accessTokenExpiresAt DateTime?
  // Non-secret server configuration for IMAP/SMTP accounts
  username             String?
  imapHost             String?
  imapPort             Int?
  imapSecurity         TransportSecurity?
  smtpHost             String?
  smtpPort             Int?
  smtpSecurity         TransportSecurity?
  rotatedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@map("email_credentials")
}

enum MailboxAccessLevel {
  READ
  REPLY // read + send from this account
  MANAGE // + settings, rules, reconnect
}

/// Who may see a mailbox. Exactly one of userId / teamId / departmentId is set
/// (enforced by a CHECK constraint in the raw migration).
model EmailAccountAccess {
  id             String             @id
  emailAccountId String
  userId         String?
  teamId         String?
  departmentId   String?
  level          MailboxAccessLevel
  grantedById    String?
  createdAt      DateTime           @default(now())

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([emailAccountId, userId])
  @@unique([emailAccountId, teamId])
  @@unique([emailAccountId, departmentId])
  @@index([userId])
  @@index([teamId])
  @@index([departmentId])
  @@map("email_account_access")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  FAILED
  DELETED
}

/// Gmail `watch` registrations and Microsoft Graph change-notification subscriptions.
model EmailWebhookSubscription {
  id              String             @id
  emailAccountId  String
  provider        MailProvider
  externalId      String? // Graph subscription id; null for Gmail watch
  resource        String
  clientStateHash String? // Graph clientState (hashed) for verification
  expiresAt       DateTime
  status          SubscriptionStatus @default(ACTIVE)
  lastNotifiedAt  DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([expiresAt, status])
  @@index([emailAccountId])
  @@map("email_webhook_subscriptions")
}

/// Provider webhook de-duplication (Pub/Sub messageId, Graph notification id, etc.).
model WebhookEvent {
  id              String       @id
  provider        MailProvider
  externalEventId String
  receivedAt      DateTime     @default(now())

  @@unique([provider, externalEventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

enum FolderType {
  INBOX
  SENT
  DRAFTS
  ARCHIVE
  SPAM
  TRASH
  STARRED
  IMPORTANT
  CUSTOM
}

/// Folders (IMAP, Graph) and labels (Gmail) normalised into one table.
model EmailFolder {
  id               String     @id
  emailAccountId   String
  providerFolderId String // Gmail label id, Graph folder id, IMAP path
  name             String
  path             String?
  type             FolderType
  syncEnabled      Boolean    @default(true)
  // IMAP cursors
  uidValidity      BigInt?
  lastUid          BigInt?
  highestModSeq    BigInt?
  // Graph cursor
  deltaLink        String?
  lastSyncedAt     DateTime?

  emailAccount EmailAccount    @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  messages     MessageFolder[]

  @@unique([emailAccountId, providerFolderId])
  @@index([emailAccountId, type])
  @@map("email_folders")
}

// ───────────────────────────── Conversations ─────────────────────────────

enum ConversationStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CLIENT
  PENDING_REPLY
  FOLLOW_UP_REQUIRED
  REPLY_NOT_NEEDED
  CLOSED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// A conversation. Always belongs to exactly one mailbox so replies go out from that account.
model EmailThread {
  id                 String             @id
  emailAccountId     String
  providerThreadId   String? // Gmail threadId / Graph conversationId / null for IMAP (header-threaded)
  subject            String
  normalizedSubject  String
  snippet            String?
  status             ConversationStatus @default(NEW)
  priority           Priority           @default(NORMAL)
  assigneeId         String?
  teamId             String?
  departmentId       String?
  contactId          String?
  messageCount       Int                @default(0)
  unreadCount        Int                @default(0)
  hasAttachments     Boolean            @default(false)
  isStarred          Boolean            @default(false)
  isArchived         Boolean            @default(false)
  isSpam             Boolean            @default(false)
  isTrashed          Boolean            @default(false)
  snoozedUntil       DateTime?
  firstMessageAt     DateTime
  lastMessageAt      DateTime
  lastInboundAt      DateTime?
  lastOutboundAt     DateTime?
  awaitingReplySince DateTime? // set when inbound arrives with no later outbound; SLA clock start
  firstResponseAt    DateTime?
  slaPolicyId        String?
  slaDueAt           DateTime?
  slaBreachedAt      DateTime?
  slaNextAt          DateTime? // when the next SLA step of the current waiting cycle is due (sweeper index)
  followUpAt         DateTime?
  closedAt           DateTime?
  version            Int                @default(0) // optimistic locking for collision detection
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  emailAccount  EmailAccount    @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  assignee      User?           @relation("ThreadAssignee", fields: [assigneeId], references: [id])
  team          Team?           @relation(fields: [teamId], references: [id])
  department    Department?     @relation(fields: [departmentId], references: [id])
  contact       Contact?        @relation(fields: [contactId], references: [id])
  slaPolicy     SlaPolicy?      @relation(fields: [slaPolicyId], references: [id])
  messages      EmailMessage[]
  assignments   Assignment[]
  statusHistory StatusHistory[]
  notes         InternalNote[]
  shares        ThreadShare[]
  tags          ThreadTag[]
  drafts        Draft[]
  tasks         Task[]
  aiSummaries   AiSummary[]
  aiSuggestions AiSuggestion[]
  slaEvents     SlaEvent[]
  notifications Notification[]
  leads         Lead[]

  @@unique([emailAccountId, providerThreadId])
  @@index([emailAccountId, lastMessageAt(sort: Desc)])
  @@index([assigneeId, status, lastMessageAt(sort: Desc)])
  @@index([departmentId, status])
  @@index([teamId, status])
  @@index([status, slaDueAt])
  @@index([slaNextAt])
  @@index([followUpAt])
  @@index([contactId])
  @@index([snoozedUntil])
  @@index([emailAccountId, normalizedSubject])
  @@map("email_threads")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model EmailMessage {
  id                String                   @id
  threadId          String
  emailAccountId    String
  providerMessageId String // Gmail id / Graph id / IMAP "<uidvalidity>:<uid>@<folder>" fallback
  internetMessageId String? // RFC 5322 Message-ID header
  inReplyTo         String?
  references        String[]
  direction         MessageDirection
  fromAddress       String
  fromName          String?
  toRecipients      Json // [{address,name}]
  ccRecipients      Json                     @default("[]")
  bccRecipients     Json                     @default("[]")
  replyTo           Json                     @default("[]")
  subject           String
  snippet           String?
  bodyText          String?
  bodyHtml          String? // sanitised on render, stored as received
  headers           Json? // selected raw headers kept for threading/debugging
  sizeBytes         Int?
  hasAttachments    Boolean                  @default(false)
  isRead            Boolean                  @default(false)
  isDraft           Boolean                  @default(false)
  isStarred         Boolean                  @default(false) // Gmail STARRED label / Outlook flag
  sentAt            DateTime?
  receivedAt        DateTime
  sentByUserId      String? // employee who sent it through the CRM
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  // Generated column (defined in migration 20261116110000_security_search); never written by the app.
  searchVector      Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('simple'::regconfig, COALESCE(subject, ''::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, ((COALESCE(\"fromAddress\", ''::text) || ' '::text) || COALESCE(\"fromName\", ''::text))), 'B'::\"char\")) || setweight(to_tsvector('simple'::regconfig, COALESCE(\"bodyText\", ''::text)), 'C'::\"char\"))"))

  thread       EmailThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  emailAccount EmailAccount    @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  sentBy       User?           @relation("MessageSentBy", fields: [sentByUserId], references: [id])
  attachments  Attachment[]
  folders      MessageFolder[]

  @@unique([emailAccountId, providerMessageId]) // duplicate prevention
  @@index([threadId, receivedAt])
  @@index([emailAccountId, internetMessageId])
  @@index([fromAddress])
  @@index([emailAccountId, receivedAt(sort: Desc)])
  @@index([searchVector], type: Gin, map: "email_messages_searchVector_idx")
  @@map("email_messages")
}

model MessageFolder {
  messageId String
  folderId  String
  imapUid   BigInt?

  message EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  folder  EmailFolder  @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@id([messageId, folderId])
  @@index([folderId, imapUid])
  @@map("message_folders")
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
  SKIPPED
}

model Attachment {
  id                   String     @id
  messageId            String?
  draftId              String?
  providerAttachmentId String?
  filename             String
  contentType          String
  sizeBytes            Int
  contentId            String? // for inline images (cid:)
  isInline             Boolean    @default(false)
  storageKey           String? // object-storage key; null until downloaded (lazy fetch)
  sha256               String?
  /// Uploaded content of a draft attachment (outbound only; inbound content stays at the provider).
  content              Bytes?
  /// Forwarding: the received attachment whose content is fetched from the provider at send time.
  sourceAttachmentId   String?
  scanStatus           ScanStatus @default(PENDING)
  createdAt            DateTime   @default(now())

  message EmailMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  draft   Draft?        @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([draftId])
  @@index([sha256])
  @@map("attachments")
}

enum DraftMode {
  NEW
  REPLY
  REPLY_ALL
  FORWARD
}

enum DraftSource {
  USER
  AI // created from an AiSuggestion; still requires an explicit human send
}

enum DraftStatus {
  EDITING
  QUEUED
  SENDING
  SENT
  FAILED
}

model Draft {
  id                 String      @id
  emailAccountId     String
  threadId           String?
  authorId           String
  mode               DraftMode
  source             DraftSource @default(USER)
  inReplyToMessageId String?
  toRecipients       Json        @default("[]")
  ccRecipients       Json        @default("[]")
  bccRecipients      Json        @default("[]")
  subject            String      @default("")
  bodyHtml           String      @default("")
  signatureId        String?
  status             DraftStatus @default(EDITING)
  idempotencyKey     String?     @unique // guards against double-send on retries
  baseThreadVersion  Int? // thread.version seen when composing; drives collision check
  approvedById       String? // the human who pressed Send
  approvedAt         DateTime?
  sentMessageId      String?
  sendError          String?
  scheduledFor       DateTime?
  /// Message-ID header set on the outgoing message (also used to detect an already-sent retry on Gmail).
  messageIdHeader    String?
  /// Graph draft created for this send (immutable id; becomes the sent message id).
  providerDraftId    String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  emailAccount EmailAccount  @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  thread       EmailThread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author       User          @relation(fields: [authorId], references: [id])
  attachments  Attachment[]
  aiSuggestion AiSuggestion?

  @@index([authorId, status])
  @@index([threadId])
  @@map("drafts")
}

model Signature {
  id             String   @id
  userId         String
  emailAccountId String? // null = default for all accounts
  name           String
  html           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAccount EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("signatures")
}

model Template {
  id           String   @id
  name         String
  subject      String?
  bodyHtml     String
  ownerId      String
  departmentId String? // shared with a department; null + isShared = company-wide
  isShared     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner      User        @relation(fields: [ownerId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([ownerId])
  @@index([departmentId])
  @@map("templates")
}

// ───────────────────────────── Assignment & status ─────────────────────────────

enum AssignmentMethod {
  MANUAL
  BULK
  RULE
  ROUND_ROBIN
  LEAST_LOADED
  AUTOMATION
  ABSENCE_REASSIGN
  LEAD_ROUTING
}

model Assignment {
  id           String           @id
  threadId     String
  assigneeId   String?
  teamId       String?
  departmentId String?
  assignedById String? // null = system
  method       AssignmentMethod
  ruleId       String?
  reason       String?
  createdAt    DateTime         @default(now())
  endedAt      DateTime?

  thread     EmailThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  assignee   User?           @relation("AssignmentAssignee", fields: [assigneeId], references: [id])
  assignedBy User?           @relation("AssignmentAssigner", fields: [assignedById], references: [id])
  team       Team?           @relation(fields: [teamId], references: [id])
  department Department?     @relation(fields: [departmentId], references: [id])
  rule       AssignmentRule? @relation(fields: [ruleId], references: [id])

  @@index([threadId, createdAt])
  @@index([assigneeId, createdAt])
  @@map("assignments")
}

enum AssignmentTargetType {
  USER
  TEAM
  DEPARTMENT
}

enum AssignmentStrategy {
  DIRECT // to the target user, or to the team/department queue unassigned
  ROUND_ROBIN
  LEAST_LOADED
}

/// Evaluated in ascending `position`; first match wins.
/// conditions JSON: { all?: Cond[], any?: Cond[] } where
///   Cond = { field: "toAddress"|"fromAddress"|"fromDomain"|"subject"|"body"|"emailAccountId"|"aiCategory",
///            op: "equals"|"contains"|"matches"|"in", value: string|string[] }
model AssignmentRule {
  id           String               @id
  name         String
  position     Int
  isEnabled    Boolean              @default(true)
  conditions   Json
  targetType   AssignmentTargetType
  targetUserId String?
  teamId       String?
  departmentId String?
  strategy     AssignmentStrategy   @default(DIRECT)
  setPriority  Priority?
  createdById  String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  team        Team?        @relation(fields: [teamId], references: [id])
  department  Department?  @relation(fields: [departmentId], references: [id])
  assignments Assignment[]

  @@index([isEnabled, position])
  @@map("assignment_rules")
}

model RoundRobinCursor {
  teamId     String   @id
  lastUserId String?
  updatedAt  DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("round_robin_cursors")
}

enum ChangeSource {
  USER
  SYSTEM
  INBOUND_MESSAGE
  OUTBOUND_MESSAGE
  AUTOMATION
  SLA
}

model StatusHistory {
  id          String              @id
  threadId    String
  fromStatus  ConversationStatus?
  toStatus    ConversationStatus
  changedById String?
  source      ChangeSource
  reason      String?
  createdAt   DateTime            @default(now())

  thread    EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  changedBy User?       @relation(fields: [changedById], references: [id])

  @@index([threadId, createdAt])
  @@map("status_history")
}

// ───────────────────────────── Collaboration ─────────────────────────────

/// Internal notes live only in this table and are never part of any outbound MIME build.
model InternalNote {
  id        String    @id
  threadId  String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  thread   EmailThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id])
  mentions NoteMention[]

  @@index([threadId, createdAt])
  @@map("internal_notes")
}

model NoteMention {
  noteId String
  userId String

  note InternalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId])
  @@map("note_mentions")
}

/// Explicit per-conversation share; grants ASSIGNED-scope access to that one thread.
model ThreadShare {
  threadId   String
  userId     String
  sharedById String
  canReply   Boolean  @default(false)
  createdAt  DateTime @default(now())

  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user     User        @relation("ShareTarget", fields: [userId], references: [id], onDelete: Cascade)
  sharedBy User        @relation("ShareAuthor", fields: [sharedById], references: [id])

  @@id([threadId, userId])
  @@index([userId])
  @@map("thread_shares")
}

model Tag {
  id        String   @id
  name      String   @unique
  color     String   @default("#64748b")
  createdAt DateTime @default(now())

  threads  ThreadTag[]
  contacts ContactTag[]

  @@map("tags")
}

model ThreadTag {
  threadId  String
  tagId     String
  addedById String?
  createdAt DateTime @default(now())

  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag    Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@index([tagId])
  @@map("thread_tags")
}

// ───────────────────────────── CRM ─────────────────────────────

enum ContactType {
  CLIENT
  PROSPECT
  VENDOR
  PARTNER
  CANDIDATE
  OTHER
}

model Company {
  id        String   @id
  name      String
  domain    String?  @unique // lower-cased; free-mail domains are never stored here
  website   String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  leads    Lead[]

  @@index([name])
  @@map("companies")
}

model Contact {
  id              String      @id
  name            String?
  phone           String?
  companyId       String?
  website         String?
  country         String?
  type            ContactType @default(OTHER)
  ownerId         String?
  departmentId    String?
  notes           String?
  lastContactedAt DateTime?
  mergedIntoId    String? // soft-merge pointer; merged contacts are hidden but retained
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company    Company?       @relation(fields: [companyId], references: [id])
  owner      User?          @relation(fields: [ownerId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  mergedInto Contact?       @relation("ContactMerge", fields: [mergedIntoId], references: [id])
  mergedFrom Contact[]      @relation("ContactMerge")
  emails     ContactEmail[]
  tags       ContactTag[]
  threads    EmailThread[]
  leads      Lead[]
  tasks      Task[]

  @@index([companyId])
  @@index([ownerId])
  @@index([mergedIntoId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "contacts_name_trgm_idx")
  @@map("contacts")
}

model ContactEmail {
  id        String  @id
  contactId String
  email     String  @unique // lower-cased
  isPrimary Boolean @default(false)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "contact_emails_email_trgm_idx")
  @@map("contact_emails")
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  INTERESTED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  INBOUND_EMAIL
  MANUAL
}

model Lead {
  id              String     @id
  title           String
  contactId       String
  companyId       String?
  sourceThreadId  String?
  source          LeadSource
  status          LeadStatus @default(NEW)
  ownerId         String?
  estimatedValue  Decimal?   @db.Decimal(14, 2)
  currency        String?    @default("USD")
  serviceInterest String? // e.g. "SEO", "PPC", "Web Development"
  aiConfidence    Float? // set when auto-detected
  lostReason      String?
  wonAt           DateTime?
  lostAt          DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  contact       Contact             @relation(fields: [contactId], references: [id])
  company       Company?            @relation(fields: [companyId], references: [id])
  sourceThread  EmailThread?        @relation(fields: [sourceThreadId], references: [id])
  owner         User?               @relation(fields: [ownerId], references: [id])
  statusHistory LeadStatusHistory[]
  tasks         Task[]

  @@index([ownerId, status])
  @@index([status, createdAt])
  @@index([contactId])
  @@map("leads")
}

model LeadStatusHistory {
  id          String      @id
  leadId      String
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  changedById String?
  note        String?
  createdAt   DateTime    @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_status_history")
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

model Task {
  id          String     @id
  title       String
  description String?
  dueAt       DateTime?
  status      TaskStatus @default(OPEN)
  assigneeId  String
  createdById String?
  threadId    String?
  leadId      String?
  contactId   String?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignee  User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User?        @relation("TaskCreator", fields: [createdById], references: [id])
  thread    EmailThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact   Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, dueAt])
  @@map("tasks")
}

// ───────────────────────────── Notifications ─────────────────────────────

enum NotificationType {
  ASSIGNED
  REASSIGNED
  CLIENT_REPLIED
  FOLLOW_UP_DUE
  SLA_REMINDER
  SLA_OVERDUE
  SLA_ESCALATED
  NOTE_MENTION
  MANAGER_NOTE
  LEAD_ASSIGNED
  URGENT_EMAIL
  ACCOUNT_NEEDS_REAUTH
  TASK_DUE
}

model Notification {
  id        String           @id
  userId    String
  type      NotificationType
  title     String
  body      String?
  data      Json?
  threadId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread EmailThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  userId String
  type   NotificationType
  inApp  Boolean          @default(true)
  push   Boolean          @default(true)
  email  Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preferences")
}

model PushSubscription {
  id        String   @id
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ───────────────────────────── SLA ─────────────────────────────

/// weeklyHours JSON: { "mon": [["09:00","18:00"]], ..., "sun": [] } in `timezone`.
model BusinessCalendar {
  id          String   @id
  name        String
  timezone    String
  weeklyHours Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  holidays    Holiday[]
  departments Department[]
  slaPolicies SlaPolicy[]

  @@map("business_calendars")
}

model Holiday {
  id         String   @id
  calendarId String
  date       DateTime @db.Date
  name       String

  calendar BusinessCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@map("holidays")
}

/// Matching: most specific (department + priority) wins, then department, then priority, then default.
model SlaPolicy {
  id           String    @id
  name         String
  departmentId String?
  priority     Priority?
  calendarId   String
  isEnabled    Boolean   @default(true)
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department Department?      @relation(fields: [departmentId], references: [id])
  calendar   BusinessCalendar @relation(fields: [calendarId], references: [id])
  steps      SlaStep[]
  threads    EmailThread[]

  @@index([departmentId, priority])
  @@map("sla_policies")
}

enum SlaAction {
  NOTIFY_ASSIGNEE
  REMIND_ASSIGNEE
  ALERT_MANAGER // team leader, then department manager
  ESCALATE // MD / super admin + mark breached
}

model SlaStep {
  id                   String    @id
  policyId             String
  afterBusinessMinutes Int // 0 = immediately on assignment
  action               SlaAction
  marksOverdue         Boolean   @default(false)

  policy SlaPolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  events SlaEvent[]

  @@unique([policyId, afterBusinessMinutes, action])
  @@map("sla_steps")
}

/// One row per step fired per waiting cycle — makes SLA jobs idempotent.
model SlaEvent {
  id         String   @id
  threadId   String
  stepId     String
  cycleStart DateTime // thread.awaitingReplySince at firing time
  firedAt    DateTime @default(now())

  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  step   SlaStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([threadId, stepId, cycleStart])
  @@map("sla_events")
}

// ───────────────────────────── Automation ─────────────────────────────

enum AutomationTrigger {
  MESSAGE_RECEIVED
  MESSAGE_SENT
  THREAD_ASSIGNED
  STATUS_CHANGED
  SLA_STEP
  LEAD_DETECTED
  USER_ABSENT
  SCHEDULE // cron expression in `schedule`
}

/// conditions: same grammar as AssignmentRule.conditions plus thread fields.
/// actions: ordered [{ type: "assign"|"set_status"|"set_priority"|"add_tag"|"notify"|"create_task"
///                     |"create_lead"|"request_ai_draft", params: {...} }]
/// No action type exists that sends an external email.
model AutomationRule {
  id          String            @id
  name        String
  description String?
  trigger     AutomationTrigger
  schedule    String?
  conditions  Json
  actions     Json
  isEnabled   Boolean           @default(false)
  position    Int               @default(0)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  runs AutomationRun[]

  @@index([trigger, isEnabled, position])
  @@map("automation_rules")
}

enum RunStatus {
  SUCCEEDED
  SKIPPED
  FAILED
}

model AutomationRun {
  id             String    @id
  ruleId         String
  threadId       String?
  idempotencyKey String    @unique // ruleId + triggering event id
  status         RunStatus
  error          String?
  output         Json?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, startedAt])
  @@map("automation_runs")
}

// ───────────────────────────── AI ─────────────────────────────

enum AiInsightKind {
  SUMMARY
  CATEGORY
  SENTIMENT
  URGENCY
  LEAD_DETECTION
  FOLLOW_UP
}

/// Cached AI analysis, invalidated when a newer message arrives (upToMessageId).
model AiSummary {
  id            String        @id
  threadId      String
  kind          AiInsightKind
  model         String
  content       Json
  upToMessageId String
  inputTokens   Int?
  outputTokens  Int?
  createdAt     DateTime      @default(now())

  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, kind, upToMessageId])
  @@index([threadId, kind, createdAt(sort: Desc)])
  @@map("ai_summaries")
}

enum AiSuggestionKind {
  REPLY
  IMPROVE_GRAMMAR
  ADJUST_TONE
}

enum AiSuggestionStatus {
  PROPOSED
  USED_AS_DRAFT
  DISCARDED
}

model AiSuggestion {
  id            String             @id
  threadId      String?
  requestedById String
  kind          AiSuggestionKind
  model         String
  input         Json? // tone, instructions (no secrets)
  content       String
  status        AiSuggestionStatus @default(PROPOSED)
  draftId       String?            @unique
  createdAt     DateTime           @default(now())

  thread      EmailThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  requestedBy User         @relation(fields: [requestedById], references: [id])
  draft       Draft?       @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([threadId])
  @@map("ai_suggestions")
}

// ───────────────────────────── Operations ─────────────────────────────

enum SyncKind {
  INITIAL
  INCREMENTAL
  WEBHOOK
  POLL
  IDLE
  SEND
  FLAG_PUSH // read/star/archive pushed back to provider
  SUBSCRIPTION_RENEW
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model SyncLog {
  id              String     @id
  emailAccountId  String
  kind            SyncKind
  status          SyncStatus
  messagesAdded   Int        @default(0)
  messagesUpdated Int        @default(0)
  error           String?
  details         Json?
  attempt         Int        @default(1)
  startedAt       DateTime   @default(now())
  finishedAt      DateTime?

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@index([emailAccountId, startedAt(sort: Desc)])
  @@index([status, startedAt])
  @@map("sync_logs")
}

enum ActorType {
  USER
  SYSTEM
  AUTOMATION
  AI
}

/// Append-only. The application DB role has INSERT + SELECT only (see raw migration).
model AuditLog {
  id         String    @id
  actorId    String?
  actorType  ActorType
  action     String // e.g. "thread.assign", "message.send", "account.connect", "contact.merge"
  entityType String
  entityId   String?
  ip         String?
  userAgent  String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime  @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
