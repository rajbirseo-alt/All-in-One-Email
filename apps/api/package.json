    "@types/luxon": "^3.7.6",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "supertest": "^7.3.2",
    "unplugin-swc": "^1.6.0"
