# ── Copy to .env for local development. Never commit real values. ──────────────

# Database. Local: `npm run db:local` starts PostgreSQL 17 on 54329 (no Docker needed).
DATABASE_URL=postgresql://crm:crm_local_dev@localhost:54329/crm

# Public origin of the web app (the API is reached through it at /api).
APP_URL=http://localhost:3000
# Where the web server proxies /api/* (Render: the API's private host:port).
API_INTERNAL_URL=http://localhost:4000
PORT=4000

# Company domains (comma-separated). Workspace / company-tenant sign-in must use these.
ALLOWED_LOGIN_DOMAINS=seodiscovery.com

# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
SESSION_SECRET=
# Master key(s) for encrypting secrets at rest. Generate one with:
#   node -e "console.log(JSON.stringify({1:require('crypto').randomBytes(32).toString('base64')}))"
# To rotate: add version 2, keep 1 until all data is re-wrapped.
ENCRYPTION_KEYS=

PASSWORD_LOGIN_ENABLED=true
# Also let invited employees sign in with Gmail or a personal Microsoft account
# (Outlook.com/Hotmail/Live). Other consumer addresses and other companies' tenants stay blocked.
PERSONAL_ACCOUNT_LOGIN=true

# Google sign-in (Google Cloud console → OAuth client, type "Web application").
# Consent screen user type: External (Internal would exclude Gmail users). Scopes: openid email profile.
# Redirect URI: ${APP_URL}/api/v1/auth/sso/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft sign-in (Entra ID → App registrations). Supported account types:
#   "Accounts in any organizational directory and personal Microsoft accounts"
#   (with PERSONAL_ACCOUNT_LOGIN=false, "this organizational directory only" is enough).
# Only MICROSOFT_TENANT_ID and personal accounts are accepted; other tenants are rejected in code.
# Redirect URI: ${APP_URL}/api/v1/auth/sso/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Optional tuning
# SESSION_IDLE_HOURS=12
# SESSION_MAX_DAYS=7
# LOGIN_RATE_LIMIT_PER_MIN=10
# TRUST_PROXY_HOPS=1

# ── Mailboxes (Phase 2) ──
# Connecting mailboxes reuses GOOGLE_* / MICROSOFT_* above; add these redirect URIs to the same apps:
#   ${APP_URL}/api/v1/accounts/oauth/google/callback
#   ${APP_URL}/api/v1/accounts/oauth/microsoft/callback
# MAIL_INITIAL_SYNC_DAYS=30
# MAIL_RETENTION_DAYS=120
# Gmail push (optional; without it Gmail is checked every 5 minutes):
# GMAIL_PUBSUB_TOPIC=projects/<project>/topics/gmail-push
# GMAIL_PUSH_SERVICE_ACCOUNT=<service account on the push subscription>@<project>.iam.gserviceaccount.com
# GMAIL_PUSH_AUDIENCE=   # only if the push subscription uses a custom audience

# ── Browser push notifications (Phase 6, optional). Generate once: npx web-push generate-vapid-keys ──
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:it@seodiscovery.com

# Background worker (sync, push renewal, purge): npm run start:worker:local -w @crm/api
